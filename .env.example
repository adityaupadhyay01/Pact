# Copy to .env.local and fill in. Keys stay on the server; never commit .env.local.
# Without GEMINI_API_KEY and CHANNEL3_API_KEY only the labelled test store works
# (real-product mode refuses to run rather than guess). Without PayPal keys,
# payments use a built-in simulator. Without Supabase, sessions live in memory.

# Gemini (https://aistudio.google.com/apikey). Free tier: Google may use prompts to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Channel3 product catalog (https://trychannel3.com). Free tier: 1,000 search credits a month.
CHANNEL3_API_KEY=
# CHANNEL3_API_BASE=https://api.trychannel3.com

# PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Supabase (needed when deployed on Vercel). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Receipt signing key (HMAC). Required when hosted, so receipts stay verifiable
# across restarts and serverless instances. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVIDENCE_SECRET=
