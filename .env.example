# Copy to .env.local and fill in. Every variable is optional:
# without them PACT runs with a rule-based parser, a PayPal simulator and in-memory storage.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Supabase (needed when deployed on Vercel). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Receipt signing key (HMAC). Required when hosted, so receipts stay verifiable
# across restarts and serverless instances. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVIDENCE_SECRET=
